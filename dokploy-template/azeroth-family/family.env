# Generated by scripts/ini2env.py -- do not edit by hand.
# Source: family-settings.ini
# =============================================================================
#  Family server settings -- EDIT THIS FILE, not family.env
# =============================================================================
#  These are real AzerothCore / mod-playerbots config keys, spelled exactly as
#  they appear in worldserver.conf.dist and playerbots.conf.dist.
#
#  After changing anything here, regenerate the env file:
#      python3 scripts/ini2env.py family-settings.ini > family.env
#
#  Then redeploy in Dokploy. No rebuild needed -- these are runtime settings.
# =============================================================================


# -----------------------------------------------------------------------------
#  REALM BASICS
# -----------------------------------------------------------------------------

# 0 = NORMAL (PvE). No open-world PvP, no ganking, nobody can attack the kids.
# 1 = PvP, 4 = RP, 6 = RP-PvP. Leave this at 0.
AC_GAME_TYPE=0

AC_REALM_ZONE=1

AC_MOTD=Bienvenidos a Azeroth! Escribe .help para ver los comandos.

# 255 = auto-detect from the client. The server data files are enUS (required
# by playerbots, its spell logic matches on English spell names), but the
# client still renders everything it owns in Spanish. Leave at 255.
AC_DBC_LOCALE=255

# Home server: roughly (CPU cores - 2). Do not go above 8, it makes things
# worse, not better. AzerothCore is bound by single-core speed.
AC_MAP_UPDATE_THREADS=4

# Anti-cheat that kicks clients it does not recognise. Useless on a private
# family realm and a common cause of mystery disconnects when using addons.
AC_WARDEN_ENABLED=0

AC_CLOSE_IDLE_CONNECTIONS=0

# Print helpful "you are connected to..." info on login.
AC_SERVER_LOGIN_INFO=1


# -----------------------------------------------------------------------------
#  GENTLE PROGRESSION -- short sessions should still feel rewarding
# -----------------------------------------------------------------------------
#  x3 is the sweet spot for kids: fast enough that a 45-minute session shows
#  visible progress, slow enough that zones and quests still make sense.
#  Bump to 5-7 if levelling still feels like homework. Above ~10 you outlevel
#  the quest chains and the world stops making narrative sense.

AC_RATE_XP_KILL=3
AC_RATE_XP_QUEST=3
AC_RATE_XP_QUEST_DF=3
AC_RATE_XP_EXPLORE=3
AC_RATE_XP_PET=3

AC_RATE_DROP_MONEY=3

AC_RATE_REST_IN_GAME=3
AC_RATE_REST_OFFLINE_IN_TAVERN_OR_CITY=3

AC_RATE_REPUTATION_GAIN=2

# Loot drop rates. x2 on the good stuff means more "look what I got!" moments
# without flooding bags with grey vendor trash.
AC_RATE_DROP_ITEM_UNCOMMON=2
AC_RATE_DROP_ITEM_RARE=2
AC_RATE_DROP_ITEM_EPIC=2


# -----------------------------------------------------------------------------
#  NO PUNISHMENT ON DEATH -- the single biggest source of kid frustration
# -----------------------------------------------------------------------------

# Resurrection sickness applies from this level upward. Max level is 80, so
# 100 means it never happens.
AC_DEATH_SICKNESS_LEVEL=100

# Seconds you must wait before you can reclaim your corpse. 0 = instantly.
AC_DEATH_CORPSE_RECLAIM_DELAY_PV_E=0
AC_DEATH_CORPSE_RECLAIM_DELAY_PV_P=0

# Broken gear that costs gold to repair, after a death that was already sad.
AC_DURABILITY_LOSS_ON_DEATH=0
AC_DURABILITY_LOSS_ON_SPIRIT_RESURRECT=0
AC_DURABILITY_LOSS_IN_PV_P=0
AC_DURABILITY_LOSS_CHANCE_DAMAGE=0
AC_DURABILITY_LOSS_CHANCE_ABSORB=0
AC_DURABILITY_LOSS_CHANCE_PARRY=0
AC_DURABILITY_LOSS_CHANCE_BLOCK=0

# No fall damage. Kids jump off things. Constantly.
AC_RATE_DAMAGE_FALL=0

# 0 = everyone breathes underwater forever. Drowning while exploring a lake is
# a classic small-child meltdown.
AC_DISABLE_WATER_BREATH=0


# -----------------------------------------------------------------------------
#  LESS TEDIUM
# -----------------------------------------------------------------------------

# Every flight point known from character creation, both factions.
AC_ALL_FLIGHT_PATHS=1

# 2 = instant flights, but each flight master lets you toggle the scenic route
# back on. Best of both: no 6-minute silent flight, but the option remains.
AC_INSTANT_FLIGHT_PATHS=2

# Lets a small family group complete quests flagged as raid content.
AC_QUESTS_IGNORE_RAID=1

# Keeps your bot group together when someone logs out for dinner.
AC_LEAVE_GROUP_ON_LOGOUT_ENABLED=0


# =============================================================================
#  PLAYERBOTS
# =============================================================================

AC_AI_PLAYERBOT_ENABLED=1

# The module default is 500 random bots. That is a public-server number and it
# will melt a home machine. 40 is plenty to make the world feel alive: you will
# see other "players" in cities and questing zones.
AC_AI_PLAYERBOT_MIN_RANDOM_BOTS=40
AC_AI_PLAYERBOT_MAX_RANDOM_BOTS=40

AC_AI_PLAYERBOT_RANDOM_BOT_AUTOLOGIN=1

# Bots only wake up when a real person is online. On a family server that is
# most of the day, so this saves a lot of CPU and electricity.
AC_AI_PLAYERBOT_DISABLED_WITHOUT_REAL_PLAYER=1
AC_AI_PLAYERBOT_DISABLED_WITHOUT_REAL_PLAYER_LOGIN_DELAY=15
AC_AI_PLAYERBOT_DISABLED_WITHOUT_REAL_PLAYER_LOGOUT_DELAY=120

# Max bots one player can have in their own party. 4 gives a full 5-man group,
# which is what you want for dungeons. The module default of 40 lets a kid
# summon a 40-bot raid, which is funny once and then unplayable.
AC_AI_PLAYERBOT_MAX_ADDED_BOTS=4

# Random bots stay in this level band.
AC_AI_PLAYERBOT_RANDOM_BOT_MIN_LEVEL=1
AC_AI_PLAYERBOT_RANDOM_BOT_MAX_LEVEL=80

# No bot battlegrounds -- this is a PvE realm.
AC_AI_PLAYERBOT_RANDOM_BOT_JOIN_BG=0

# Bots can still queue for dungeons together.
AC_AI_PLAYERBOT_RANDOM_BOT_JOIN_LFG=1

# Bots do not announce group/guild invites in chat. Less noise.
AC_AI_PLAYERBOT_INVITE_CHAT=0

# Bots teleport to you when you invite them, instead of running across the map.
AC_AI_PLAYERBOT_SUMMON_WHEN_GROUP=1

# 0 = disabled, 1 = GM only, 2 = all players, 3 = auto on login.
# 2 lets a kid hand over their own character to the AI when they get stuck on
# a hard pull, which is a great "unstick me" button.
AC_AI_PLAYERBOT_SELF_BOT_LEVEL=2
