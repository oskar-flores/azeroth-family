# =============================================================================
#  Paste these into Dokploy -> your app -> Environment
#  (Do not commit the filled-in version to git.)
# =============================================================================

# --- database -----------------------------------------------------------------
# Any long random string. Nothing outside the compose network ever sees it.
DB_ROOT_PASSWORD=change-me-to-something-long

# InnoDB buffer pool. Rule of thumb: ~50% of the machine's RAM.
#   16 GB machine -> 6G     32 GB machine -> 12G     8 GB machine -> 3G
DB_BUFFER_POOL=6G

# --- images -------------------------------------------------------------------
# If Dokploy runs on the SAME machine where you ran build-and-push.sh, leave
# this as-is: the images are already in the local Docker daemon.
# If you built elsewhere and pushed, set it to e.g. ghcr.io/oskar-flores
IMAGE_PREFIX=azeroth-family
# build-and-push.sh prints the exact tag it produced, e.g. 2026.08.03-190184a.
# Paste it here. Leaving this at `latest` still works -- every build publishes
# that alias too -- but `latest` cannot be rolled back to a known build.
IMAGE_TAG=latest
# Pinned rather than `master`. Same digest today; frozen so a client-data
# refresh upstream cannot change what this stack pulls.
CLIENT_DATA_TAG=17.0.0-dev

# --- networking ---------------------------------------------------------------
# The address the game client will be told to connect to. This MUST be reachable
# from your family's machines. With Tailscale, use this host's Tailscale IP
# (starts with 100.) -- find it with:  tailscale ip -4
REALM_ADDRESS=100.x.y.z

# Which interface to listen on. Setting this to the same Tailscale IP means the
# server is invisible to your LAN, your router and the internet. Nobody who is
# not on your tailnet can even open a socket to it.
# Use 0.0.0.0 only while testing on the host itself.
BIND_ADDR=100.x.y.z

AUTH_PORT=3724
WORLD_PORT=8085

REALM_NAME=Azeroth Familiar

# --- llm bot chat -------------------------------------------------------------
# mod-llm-chatter makes the bots hold real conversations in Spanish instead of
# picking from a fixed phrase table. ac-llm-chatter-bridge refuses to start
# without this key.
#
# Get one at https://console.anthropic.com -> API Keys. It is billed per token;
# the bots chat continuously, so set a spend limit on the key before the first
# deploy rather than after.
#
# This is the one part of the stack that leaves your tailnet: prompts and bot
# chat go to Anthropic. That is the deliberate trade for a well-aligned model.
# Switching to a local Ollama box later reverses it -- see
# llm-chatter-settings.conf.
ANTHROPIC_API_KEY=sk-ant-change-me

# --- web console --------------------------------------------------------------
# ac-admin-ui is published on BIND_ADDR like everything else, so it is reachable
# at http://<your tailscale ip>:8080 and nowhere else.
UI_PORT=8080

# A dedicated GM level 3 account that ONLY the web console uses. Create it once
# on the Docker host, before the first deploy of ac-admin-ui:
#
#   ./scripts/admin.sh account acconsole <a long random password>
#   ./scripts/admin.sh gm acconsole 3
#
# This is a standing admin credential -- as powerful as your own login -- and it
# exists whether or not anyone is logged in. Dokploy env only; never committed.
SOAP_USER=acconsole
SOAP_PASS=change-me-to-something-long
